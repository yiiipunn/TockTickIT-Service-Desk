// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionEventType {
  CREATED
  UPDATED
  ASSIGNEE_CHANGED
  STATUS_CHANGED
}

enum TicketEventType {
  OWNER_CHANGED
  PRIORITY_CHANGED
  STATUS_CHANGED
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  requestedTickets Ticket[]              @relation("TicketRequester")
  ownedTickets     Ticket[]              @relation("TicketOwner")
  publicComments   PublicComment[]
  internalNotes    InternalNote[]
  sessions         Session[]
  assignedActions  ActionTaken[]         @relation("ActionAssignee")
  createdActions   ActionTaken[]         @relation("ActionCreator")
  performedActions ActionTaken[]         @relation("ActionPerformer")
  cancelledActions ActionTaken[]         @relation("ActionCanceller")
  actionEvents     ActionTakenEvent[]    @relation("ActionEventActor")
  actionEventsFrom ActionTakenEvent[]    @relation("ActionEventFromAssignee")
  actionEventsTo   ActionTakenEvent[]    @relation("ActionEventToAssignee")
  workflowEvents   TicketWorkflowEvent[] @relation("TicketWorkflowEventActor")
  workflowFrom     TicketWorkflowEvent[] @relation("TicketWorkflowFromOwner")
  workflowTo       TicketWorkflowEvent[] @relation("TicketWorkflowToOwner")

  @@index([role])
  @@index([isActive])
}

model Session {
  id                Int       @id @default(autoincrement())
  userId            Int
  tokenHash         String    @unique
  csrfTokenHash     String
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  lastActivityAt    DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id                             Int          @id @default(autoincrement())
  ticketNumber                   String       @unique
  requesterId                    Int
  ownerId                        Int?
  categoryId                     Int
  relatedSystemId                Int
  summary                        String
  requestedPriority              Priority
  itPriority                     Priority
  description                    String
  status                         TicketStatus @default(NEW)
  ownerAssignedAt                DateTime?
  requesterResolutionIndicatedAt DateTime?
  version                        Int          @default(1)
  resolvedAt                     DateTime?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  requester      User                  @relation("TicketRequester", fields: [requesterId], references: [id])
  owner          User?                 @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category       Category              @relation(fields: [categoryId], references: [id])
  relatedSystem  RelatedSystem         @relation(fields: [relatedSystemId], references: [id])
  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actions        ActionTaken[]
  workflowEvents TicketWorkflowEvent[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([requestedPriority])
  @@index([itPriority])
  @@index([status])
  @@index([updatedAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String    @unique
  mimeType         String
  sizeBytes        Int
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([ticketId, isRemoved])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model ActionTaken {
  id                 Int          @id @default(autoincrement())
  ticketId           Int
  actionAt           DateTime
  description        String
  result             String?
  status             ActionStatus @default(PLANNED)
  assigneeId         Int
  createdById        Int
  performedById      Int?
  followUpRequired   Boolean      @default(false)
  followUpNote       String?
  attachmentNotes    String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      Int?
  cancellationReason String?
  version            Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  assignee    User               @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  performedBy User?              @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  cancelledBy User?              @relation("ActionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  events      ActionTakenEvent[]

  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status, actionAt, id])
  @@index([performedById, completedAt, id])
  @@index([createdById])
  @@index([cancelledById])
}

model ActionTakenEvent {
  id             Int             @id @default(autoincrement())
  actionTakenId  Int
  actorId        Int
  eventType      ActionEventType
  fromStatus     ActionStatus?
  toStatus       ActionStatus?
  fromAssigneeId Int?
  toAssigneeId   Int?
  snapshot       Json?
  createdAt      DateTime        @default(now())

  actionTaken  ActionTaken @relation(fields: [actionTakenId], references: [id], onDelete: Restrict)
  actor        User        @relation("ActionEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromAssignee User?       @relation("ActionEventFromAssignee", fields: [fromAssigneeId], references: [id], onDelete: Restrict)
  toAssignee   User?       @relation("ActionEventToAssignee", fields: [toAssigneeId], references: [id], onDelete: Restrict)

  @@index([actionTakenId, createdAt, id])
  @@index([actorId])
  @@index([fromAssigneeId])
  @@index([toAssigneeId])
}

model TicketWorkflowEvent {
  id          Int             @id @default(autoincrement())
  ticketId    Int
  actorId     Int
  eventType   TicketEventType
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  fromOwnerId Int?
  toOwnerId   Int?
  createdAt   DateTime        @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor     User   @relation("TicketWorkflowEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromOwner User?  @relation("TicketWorkflowFromOwner", fields: [fromOwnerId], references: [id], onDelete: Restrict)
  toOwner   User?  @relation("TicketWorkflowToOwner", fields: [toOwnerId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@index([actorId])
  @@index([fromOwnerId])
  @@index([toOwnerId])
}
